

# =========================================================
# IOP - 3-channel ADC capture configuration
# =========================================================

# ---------- Channel mapping ----------
# Which ADS1256 input pin (AINx) carries each motor phase current.
# Phase 1 sensor (S1) is on AIN0, S2 on AIN1, S3 on AIN2.
ADC_CHANNEL_PHASE1=0
ADC_CHANNEL_PHASE2=1
ADC_CHANNEL_PHASE3=2

# ---------- ADC sampling ----------
# DRATE = chip's internal data rate. We multiplex three channels off it,
# so per-channel rate is roughly DRATE/3 minus Python overhead.
# 15000 SPS gives us about 1.8-2 kHz per channel after multiplex overhead,
# which matches the 2 kHz/channel target the ML pipeline expects.
ADC_DRATE_SPS=30000

# Programmable gain. 1x gives full-scale +/- 5V, fits the 0-3.3V hall sensor
# output centered around 1.5-2V offset comfortably.
ADC_GAIN=1

# SPI clock. 1.5 MHz is reliable on this HAT; 1.92 MHz is the chip's max.
SPI_HZ=1920000

# Just used for the rate-display percentage on the live console.
TARGET_SAMPLE_RATE_HZ_PER_CHANNEL=2000

# ---------- Per-sensor calibration ----------
# Each sensor was bench-calibrated independently with a DC supply and
# precision ammeter. Values are bias-circuit-applied (sensor + offset
# resistor network so AC current sees positive AND negative half-cycles
# without clipping at AGND).

# Sensor 1 (Phase 1, on AIN0)
S1_OFFSET_V=1.640
S1_SENS_V_PER_A=0.594

# Sensor 2 (Phase 2, on AIN1)
S2_OFFSET_V=1.550
S2_SENS_V_PER_A=0.559

# Sensor 3 (Phase 3, on AIN2)
S3_OFFSET_V=1.960
S3_SENS_V_PER_A=0.646

# ---------- Capture / output ----------
# Number of three-channel samples to capture. 20000 at ~2 kHz/ch = 10 sec.
# Set to 0 for unlimited (Ctrl+C to stop).
CAPTURE_SAMPLES_PER_CHANNEL=20000

CAPTURE_FILE_NAME=capture_3phase.csv

PRINT_INTERVAL_S=1.0
